<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme — Compose handles the actual UI; this is for the system splash -->
    <style name="Theme.RAKSHAK" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Splash theme (Android 12 SplashScreen API) -->
    <style name="Theme.RAKSHAK.Splash" parent="Theme.RAKSHAK">
        <item name="android:windowSplashScreenBackground">@color/background_dark</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
</resources>
